<?xml version='1.0'?>

<robot name="erl1" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:include filename="$(find erl1)/urdf/my_robot.gazebo" />



<material name="blue">
    <color rgba="0.203125 0.23828125 0.28515625 1.0"/>
</material>
 

<link name="link_chassis">
    <!-- inertial -->
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.0395416666667" ixy="0" ixz="0" iyy="0.106208333333" iyz="0" izz="0.141666666667"/>
    </inertial>
    <!-- body -->
    <collision name="collision_chassis">
      <geometry>
        <box size="0.5 0.3 0.07"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.07"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <!-- caster front -->
    <collision name="caster_front_collision">
      <origin rpy="0 0 0" xyz="0.2 0 -0.05"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <visual name="caster_front_visual">
      <origin rpy="0 0 0" xyz="0.2 0 -0.05"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>
  </link>


   <link name='left_wheel'>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <inertia
          ixx="0.014" ixy="0" ixz="0"
          iyy="0.014" iyz="0"
          izz="0.025"
      />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/> 
      <geometry>
        <cylinder radius=".1" length=".05"/>
      </geometry>
    </collision>

    <visual name='left_wheel_visual'>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder radius=".1" length=".05"/>
      </geometry>
    </visual>
  </link>

  <link name='right_wheel'>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <inertia
          ixx="0.014" ixy="0" ixz="0"
          iyy="0.014" iyz="0"
          izz="0.025"
      />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/> 
      <geometry>
        <cylinder radius=".1" length=".05"/>
      </geometry>
    </collision>

    <visual name='right_wheel_visual'>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder radius=".1" length=".05"/>
      </geometry>
    </visual>
  </link>


  <joint type="continuous" name="right_wheel_joint">
    <origin xyz="-0.1 -0.15 0" rpy="0 0 0"/>
    <child link="right_wheel"/>
    <parent link="link_chassis"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>  
  
<joint type="continuous" name="left_wheel_joint">
    <origin xyz="-0.1 0.15 0" rpy="0 0 0"/>
    <child link="left_wheel"/>
    <parent link="link_chassis"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

<link name="camera_link">
  <visual name="camera_link">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
    <material name="blue"/>
  </visual>
  <collision>
  <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </collision>
 <inertial>
  <mass value="0.3"/>
  <origin xyz="0 0 0.05" rpy="0 0 0"/>
  <inertia
      ixx="0.0005" ixy="0" ixz="0"
      iyy="0.0005" iyz="0"
      izz="0.0005"/>
</inertial>
</link>

<link name="camera_link_optical">
</link>


<joint name="camera_joint" type="revolute">
  <parent link="link_chassis"/>
  <child link="camera_link"/>
  <origin xyz="0.3 0 0.035" rpy="0 0 0"/>
  <axis xyz="0 0 1"/> 
  <limit lower="-1.57" upper="1.57" effort="5" velocity="1.0"/>
</joint>


  <joint type="fixed" name="camera_optical_joint">
    <origin xyz="0 0 0" rpy="-1.5707 0 -1.5707"/>
    <child link="camera_link_optical"/>
    <parent link="camera_link"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="link_chassis"/>
    <child link="imu_link" />
  </joint>

  <link name="imu_link">
  </link>

  <joint type="fixed" name="scan_joint">
    <origin xyz="-0.2 0 0.19" rpy="0 0 0"/>
    <child link="scan_link"/>
    <parent link="link_chassis"/>
  </joint>

  <link name='scan_link'>
    <inertial>
      <mass value="1e-5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="1e-6" ixy="0" ixz="0"
          iyy="1e-6" iyz="0"
          izz="1e-6"
      />
    </inertial>
    <collision name='collision'>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <box size=".1 .1 .1"/>
      </geometry>
    </collision>

    <visual name='scan_link_visual'>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
    </visual>
  </link>



</robot>
