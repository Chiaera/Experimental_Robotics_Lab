<?xml version="1.0"?>
<robot>
    <gazebo>
        <!--Robot movements, Odometry plugin-->
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <!-- Topic for the command input -->
            <topic>/cmd_vel</topic>
            <!-- Wheel joints -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <!-- Wheel parameters -->
            <wheel_separation>0.3</wheel_separation>
            <wheel_radius>0.1</wheel_radius>

            <!-- Control gains and limits -->
            <max_linear_acceleration>1</max_linear_acceleration>
            <min_linear_acceleration>-1</min_linear_acceleration>
            <max_angular_acceleration>2</max_angular_acceleration>
            <min_angular_acceleration>-2</min_angular_acceleration>
            <max_linear_velocity>0.5</max_linear_velocity>
            <min_linear_velocity>-0.5</min_linear_velocity>
            <max_angular_velocity>1</max_angular_velocity>
            <min_angular_velocity>-1</min_angular_velocity>
            
            <!-- Other parameters -->
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>link_chassis</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>
        </plugin>

        <!--JointPosition plugin-->
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>camera_joint</joint_name>
            <topic>/camera_joint/cmd_pos</topic>
            <p_gain>5</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.5</d_gain>
        </plugin>

        <!--JointStatePublisher plugin-->
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>camera_joint</joint_name>
        </plugin>
    </gazebo>

    <!--Camera-->
    <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <camera>
        <!--view of simulated camera-->
        <horizontal_fov>1.3962634</horizontal_fov> 
        <!--propertiews of video stream-->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <!-- Noise is sampled independently per pixel on each frame.
               That pixel's noise value is added to each of its color
               channels, which at that point lie in the range [0,1]. -->
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <!--ensure the right static transformations between coordinate system-->
        <optical_frame_id>camera_link_optical</optical_frame_id>
        <!--camera_topic that describes physical properties of the camera-->
        <camera_info_topic>camera/camera_info</camera_info_topic>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera/image</topic>
    </sensor>
  </gazebo>

  <!--IMU-->
    <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <topic>imu</topic>
        <enable_metrics>true</enable_metrics>
        <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
    </gazebo>

</robot>